# Copy to .env.local. Server-side only — never prefix with NEXT_PUBLIC_.
ANTHROPIC_API_KEY=

# Optional
# AI_PROVIDER=anthropic          # "anthropic" (default) or "fake" (offline UI development)
# AI_MODEL_CHAT=claude-opus-5-5  # override the model used for chat
# AI_MODEL_TITLE=claude-haiku-4-5
# DATABASE_PATH=./data/app.db
# Research (web search). "anthropic" uses hosted search with the key above; "brave" needs BRAVE_API_KEY.
# SEARCH_BACKEND=anthropic
# BRAVE_API_KEY=
# RESEARCH_FAKE=1                # offline development: fixed fixture pages, no network
